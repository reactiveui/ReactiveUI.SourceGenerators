<Project>
  <!-- Chain to the repository-level Directory.Build.targets (this file shadows it for this project). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))"/>

  <!-- Off-Windows, neutralize the Windows-desktop MSIX PRI generation: MakePri.exe and cswinrt.exe are native
       Windows tools that crash under Wine. Windows builds still run the real generation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\SkipMakePriOnNonWindows.targets"
          Condition="!$([MSBuild]::IsOsPlatform('Windows'))"/>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
      <PropertyGroup>
        <MauiVersion>11.0.10</MauiVersion>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
      <PropertyGroup>
        <MauiVersion>10.0.130</MauiVersion>
      </PropertyGroup>
    </When>
  </Choose>

  <PropertyGroup>
    <RoslynCommonAnalyzersVersion>5.2.0</RoslynCommonAnalyzersVersion>
    <ReactiveUIPrimitivesVersion>9.0.0</ReactiveUIPrimitivesVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing Framework. The tests run on Microsoft Testing Platform, so do not add Microsoft.NET.Test.Sdk. -->
    <PackageVersion Include="TUnit" Version="1.84.0"/>

    <!-- Roslyn Framework -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0"/>

    <!-- Test Infrastructure -->
    <PackageVersion Include="Basic.Reference.Assemblies.Net110" Version="1.8.15"/>
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.15"/>
    <PackageVersion Include="Basic.Reference.Assemblies.Net90" Version="1.8.15"/>
    <PackageVersion Include="Basic.Reference.Assemblies.Net80" Version="1.8.15"/>
    <PackageVersion Include="Basic.Reference.Assemblies.Net472" Version="1.8.15"/>

    <!-- Dependencies -->
    <PackageVersion Include="Splat" Version="21.0.0"/>
    <PackageVersion Include="ReactiveUI.Primitives" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Wpf" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Wpf.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.WinForms" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.WinForms.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Maui" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Maui.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="System.Reactive" Version="7.0.0"/>

    <!-- Build Tools -->
    <PackageVersion Include="MinVer" Version="8.0.0"/>
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)"/>
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)"/>
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)"/>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100"/>
    <PackageVersion Include="PublicApiSharp.Analyzers" Version="2.2.0"/>

    <!-- MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
    <!-- Deprecated from net11 onwards, and no net11 build ships, so it is pinned to the net10 heads. -->
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0')) AND !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))"/>

    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2"/>
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.16.0-preview.2"/>

    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.6"/>
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6"/>
    <PackageVersion Include="ReactiveUI.Primitives.Avalonia" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Avalonia.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>

    <!-- Uno Platform. Uno.WinUI is the release Uno.Sdk in global.json pins; the Windows head uses the App SDK. -->
    <PackageVersion Include="Uno.WinUI" Version="7.0.65"/>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5"/>
    <PackageVersion Include="ReactiveUI.Primitives.Uno" Version="$(ReactiveUIPrimitivesVersion)"/>
    <PackageVersion Include="ReactiveUI.Primitives.Uno.Reactive" Version="$(ReactiveUIPrimitivesVersion)"/>

    <!-- Test Infrastructure for the attribute generators -->
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0"/>
    <PackageVersion Include="DynamicData" Version="9.5.0"/>

    <!-- Avalonia sample app -->
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6"/>
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6"/>
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.23"/>
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6"/>
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.6"/>
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15"/>

    <!-- Test App Dependencies-->
    <PackageVersion Include="ReactiveUI" Version="26.0.1"/>
    <PackageVersion Include="ReactiveUI.Reactive" Version="26.0.1"/>
    <PackageVersion Include="ReactiveUI.Maui" Version="26.0.1"/>
  </ItemGroup>
</Project>

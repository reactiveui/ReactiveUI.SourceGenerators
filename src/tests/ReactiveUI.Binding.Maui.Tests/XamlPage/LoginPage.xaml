<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReactiveUI.Binding.Maui.Tests.XamlPage.LoginPage">
    <VerticalStackLayout>
        <Entry x:Name="UserName" x:FieldModifier="internal" />
        <Label x:Name="Status" x:FieldModifier="internal" />
        <Button x:Name="LoginButton" x:FieldModifier="internal" Text="Log in" />
        <CollectionView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label x:Name="ItemLabel" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>

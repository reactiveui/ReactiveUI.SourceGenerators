<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Benchmarks are public by BenchmarkDotNet's contract and are never shipped. -->
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" VersionOverride="4.14.0" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <PackageReference Include="Splat" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <!--
    The generator is referenced as a plain library, not as an analyzer: the benchmarks drive it directly so the
    measurement covers the generator rather than whatever the host build decides to do with it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\ReactiveUI.SourceGenerators.Roslyn4140\ReactiveUI.SourceGenerators.Roslyn4140.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Mocks\**" />
    <Content Include="Mocks\*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

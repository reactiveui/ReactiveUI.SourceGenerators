<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- System.Reactive-flavoured WinForms leaf: recompiles the shared WinForms source against
         ReactiveUI.Binding.Reactive, shifting its types to ReactiveUI.Binding.Reactive.WinForms.
         REACTIVE_SHIM comes from ReactiveShim.props via the '.Reactive' name suffix. -->
    <TargetFrameworks>$(BindingWindowsOnlyTargets)</TargetFrameworks>
    <RootNamespace>ReactiveUI.Binding.Reactive.WinForms</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <PackageDescription>WinForms platform support for ReactiveUI.Binding.Reactive, for consumers on System.Reactive.</PackageDescription>
    <PackageTags>reactiveui;binding;winforms;system.reactive</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReactiveUI.Binding.WinForms.Shared\**\*.cs" Link="ReactiveUI.Binding.WinForms.Shared\%(RecursiveDir)%(Filename)%(Extension)"/>
    <Compile Include="..\ReactiveUI.Binding.Platform.Shared\**\*.cs" Link="ReactiveUI.Binding.Platform.Shared\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives.Disposables"/>
    <Using Include="System"/>
    <Using Include="System.ComponentModel"/>
    <Using Include="System.Diagnostics"/>
    <Using Include="System.Diagnostics.CodeAnalysis"/>
    <Using Include="System.Runtime.CompilerServices"/>
    <Using Include="Splat"/>
    <Using Include="ReactiveUI.Primitives.Reactive.Concurrency.ControlSequencer" Alias="ControlSequencer"/>
  </ItemGroup>

  <!-- The shifted counterparts of the lean leaf's imports. -->
  <ItemGroup>
    <Using Include="ReactiveUI.Binding.Reactive.Builder"/>
    <Using Include="ReactiveUI.Binding.Reactive.Helpers"/>
    <Using Include="ReactiveUI.Binding.Reactive.ObservableForProperty"/>
    <Using Include="ReactiveUI.Binding.Reactive.Observables"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Binding.Reactive\ReactiveUI.Binding.Reactive.csproj"/>
    <PackageReference Include="ReactiveUI.Primitives.WinForms.Reactive"/>
  </ItemGroup>

  <!-- A recompilation of ReactiveUI.Binding.WinForms.Shared, which ReactiveUI.Binding.WinForms already
       covers. See the note on ReactiveUI.Binding.Reactive for why this is an attribute and not a module path. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.0'))">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
  </ItemGroup>
</Project>

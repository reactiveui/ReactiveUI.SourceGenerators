<Project Sdk="Microsoft.NET.Sdk">

  <!-- The package consumers install: the public attributes the generators read, with the generators and code fixes
       bundled under analyzers/. The attributes are public types here, so no consumer declares its own copy, and an
       assembly granted InternalsVisibleTo never sees two. They are [Conditional], so a consumer keeps no reference to
       this assembly. -->
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTfms)</TargetFrameworks>
    <PackageDescription>A MVVM framework that integrates with the Reactive Extensions for .NET to create elegant, testable User Interfaces that run on any mobile or desktop platform. This is the Source Generators package for ReactiveUI</PackageDescription>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Built before packing; bundled below rather than referenced or depended on. -->
  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.SourceGenerators.Analyzers.CodeFixes\ReactiveUI.SourceGenerators.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ReactiveUI.SourceGenerators.Roslyn5000\ReactiveUI.SourceGenerators.Roslyn5000.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ReactiveUI.SourceGenerators.Roslyn4140\ReactiveUI.SourceGenerators.Roslyn4140.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ReactiveUI.SourceGenerators.Roslyn480\ReactiveUI.SourceGenerators.Roslyn480.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Three Roslyn bands ship; the compiler auto-selects the highest one <= its own version:
         roslyn4.8  — VS 2022 17.8+, the whole .NET 8 SDK line (8.0.1xx Roslyn 4.8 .. 8.0.4xx Roslyn 4.11)
                      plus VS 17.12/17.13 (Roslyn 4.12/4.13), since the next band is 4.14
         roslyn4.14 — VS 2022 17.14, .NET SDK 9.0.3xx
         roslyn5.0  — VS 2026, .NET 10 SDK
       The 4.8 baseline keeps the supported .NET 8 line (through Nov 2026) working — see README.
       The code fixes are built against Roslyn 4.8, so every band carries the same assembly. -->
  <PropertyGroup>
    <_RoslynOutput>bin\$(Configuration)\netstandard2.0\ReactiveUI.SourceGenerators.Roslyn.dll</_RoslynOutput>
    <_CodeFixesOutput>..\ReactiveUI.SourceGenerators.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\ReactiveUI.SourceGenerators.Analyzers.CodeFixes.dll</_CodeFixesOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\ReactiveUI.SourceGenerators.Roslyn480\$(_RoslynOutput);$(_CodeFixesOutput)" PackagePath="analyzers\dotnet\roslyn4.8\cs" Pack="true" Visible="false" />
    <None Include="..\ReactiveUI.SourceGenerators.Roslyn4140\$(_RoslynOutput);$(_CodeFixesOutput)" PackagePath="analyzers\dotnet\roslyn4.14\cs" Pack="true" Visible="false" />
    <None Include="..\ReactiveUI.SourceGenerators.Roslyn5000\$(_RoslynOutput);$(_CodeFixesOutput)" PackagePath="analyzers\dotnet\roslyn5.0\cs" Pack="true" Visible="false" />
  </ItemGroup>

</Project>
